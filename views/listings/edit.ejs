<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
   <div class="col-8 offset-2">
        <h3>Edit your Listing</h3>
        <form  method="post" 
        action="/listings/<%=listing._id%>?_method=PUT"
        novalidate
        class="needs-validation"
        >
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" type="text" class="form-control"
            value="<%=listing.title%>"
            required
            >
            <div class="invalid-feedback"> title should be valid </div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required>
            <%=listing.description%> </textarea>
            <div class="invalid-feedback"> Description name should be valid </div>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image][url]" type="text" class="form-control" required
            value="<%=listing.image.url%>">
            <div class="invalid-feedback"> Image url should be valid </div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" type="number" class="form-control" required
                value="<%=listing.price%>" >
                <div class="invalid-feedback"> Price should be valid </div>
            </div>
    
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" type="text" class="form-control" required
                value="<%=listing.country%>">
                <div class="invalid-feedback"> Country name should be valid </div>
            </div>  
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">location</label>
            <input name="listing[location]" type="text" class="form-control" required
            value="<%=listing.location%>" >
            <div class="invalid-feedback"> Listing location  should be valid </div>
        </div>
        <br><br><br>
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </div> 
</div>
<script src="/js/script.js"></script>
